# ==========================================
# AdminServ Docker Environment Variables
# ==========================================

# Port to expose on the host machine (Default: 8080)
ADMINSERV_PORT=8080

# Master Configuration Password (optional: overrides password in config/adminserv.php)
CONFIG_PASSWORD=

# PHP Runtime Settings
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=25M
PHP_POST_MAX_SIZE=30M
PHP_MAX_EXECUTION_TIME=60
